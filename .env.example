# SmartAudit efr · environment template (NO secrets here). Copy to .env and fill in.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   # JWT_SECRET, EMAIL_HASH_KEY
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      # FIELD_ENCRYPTION_KEY (exactly 32 bytes)

# ---- Common
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# ---- Staging / production only (infra/docker-compose.yml)
DOMAIN=staging.efr.bumii.ai
ACME_EMAIL=
MONGO_USER=smartaudit
MONGO_PASSWORD=

# ---- Database (local without Docker: add &directConnection=true when connecting from the host)
MONGO_URL=mongodb://localhost:27017/smartaudit?replicaSet=rs0&directConnection=true

# ---- Web
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# ---- Secrets (required)
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
EMAIL_HASH_KEY=

# ---- Mail (Google Workspace SMTP for bumii.ai; Mailpit in development)
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=SmartAudit efr
MAIL_FROM_ADDRESS=no-reply@bumii.ai

# ---- Test environments without email: show the magic link on screen (refused in production)
DEV_SHOW_MAGIC_LINK=false

# ---- Backups (infra/scripts/backup.sh)
BACKUP_PASSPHRASE=
BACKUP_RCLONE_REMOTE=
BACKUP_KEEP_DAYS=14

# ---- AI (Phase 2)
LLM_PROVIDER=mock
# Gemini (LLM_PROVIDER=gemini). In the servers the key is an encrypted systemd credential
# (infra/scripts/set-gemini-key.sh); locally you may use GEMINI_API_KEY or GEMINI_API_KEY_FILE.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
