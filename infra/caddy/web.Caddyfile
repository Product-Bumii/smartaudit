# Static Angular build inside the `web` container (SPA fallback to index.html).
:80 {
	root * /srv
	encode zstd gzip
	@assets path *.js *.css *.woff2 *.woff *.ico *.png *.svg
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-store"
	header /i18n/* Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
