[Unit]
Description=SmartAudit efr API (Node) · powered by Bumii
After=network-online.target mongod-smartaudit.service
Wants=network-online.target mongod-smartaudit.service

[Service]
Type=simple
User=smartaudit
Group=smartaudit
WorkingDirectory=/opt/smartaudit/current/api
EnvironmentFile=/opt/smartaudit/shared/.env
# Gemini API key: encrypted systemd credential (/etc/credstore.encrypted/gemini_api_key), decrypted only for
# this service into $CREDENTIALS_DIRECTORY. Never in .env. Set/rotate it with infra/scripts/set-gemini-key.sh.
ImportCredential=gemini_api_key
ExecStart=/usr/bin/node --max-old-space-size=160 server.cjs
Restart=always
RestartSec=3
MemoryMax=320M
TimeoutStopSec=15

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
